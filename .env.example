# PortableCoder configuration overrides.
# Copy this file to ".env.example" (same folder) and edit values as needed.
# Both Start-Model.bat and the Python agent (agent/config.py) read this
# same file, so ports/paths stay consistent between the two processes.
#
# Format: KEY=VALUE, one per line. Lines starting with # are comments.
# No quoting needed around values.

# --- Model server (read by Start-Model.bat) ---------------------------
MODEL_PATH=models\qwen2.5-coder-7b-instruct-q4_k_m.gguf
CONTEXT_SIZE=2048
GPU_LAYERS=12
CPU_THREADS=6
MODEL_PORT=8080

# Backend-specific extra flags for llama-server.exe, appended verbatim.
# Leave blank for a CUDA build that auto-selects its device.
# Example for a Vulkan build that needs an explicit device index
# (check with `llama-server.exe --list-devices` first):
#   EXTRA_ARGS=-dev Vulkan1
EXTRA_ARGS=

# --- Agent API (read by agent/config.py and Start-Agent.bat) ----------
AGENT_PORT=8787

# Optional: override the model name string sent to the /v1/chat/completions
# API. Must match what llama-server.exe reports/expects; usually you don't
# need to change this.
# LLM_MODEL_NAME=qwen2.5-coder-7b-instruct

# Agent loop budgets.
MAX_AGENT_TURNS=12
COMMAND_TIMEOUT_SECONDS=90

# --- Tuning notes -------------------------------------------------------
# GPU_LAYERS: increase by 2 at a time. Watch `nvidia-smi -l 1` while a
#   request is running. Stop before dedicated GPU memory use reaches
#   about 3.7 GB (leaves headroom on a 4 GB card before CUDA/Vulkan OOM).
#   If you see an out-of-memory error, reduce GPU_LAYERS by at least 2
#   from the last value you tried.
#
# CPU_THREADS: benchmark 4, 6, and 8 on your own machine and keep whichever
#   is fastest for your workload. This project ships 6 as a conservative
#   default for a 4-physical-core CPU, leaving headroom for the OS and the
#   agent's own Python process. Some users see better throughput at 8
#   (all logical threads) depending on background load — there is no
#   universally correct value, test it.
