# Portable USB LLM Agent configuration.
# Copy this file to ".env" in the same folder, then edit values as needed.
# Start-Model.bat, Start-Agent.bat, and agent/config.py all read the same
# .env, so ports/paths/model stay consistent across every process.
#
# Format: KEY=VALUE, one per line. Lines starting with # are comments.
# No quoting needed around values.

# --- Model server (read by Start-Model.bat) ---------------------------
# Path to your GGUF model file, relative to the project root.
MODEL_PATH=models\your-model.gguf
CONTEXT_SIZE=4096
GPU_LAYERS=0
CPU_THREADS=6
MODEL_PORT=8080
# Which server binary to launch:
#   auto         - use runtime\windows\llama-server.exe if present,
#                  otherwise fall back to LLAMA_EXE (llama.exe serve).
#                  This is the default and normally needs no change.
#   llama-server - force runtime\windows\llama-server.exe.
#   llama-cli    - force LLAMA_EXE (a "llama.exe serve"-style build).
BACKEND=auto
# Path or bare name of the llama.exe-style CLI build, used when BACKEND
# is llama-cli or when auto-detection falls back to it. A bare name
# (default) is resolved via PATH; use a full path if it isn't on PATH,
# e.g. LLAMA_EXE=C:\Users\you\AppData\Local\Microsoft\WindowsApps\llama.exe
LLAMA_EXE=llama.exe
# Backend-specific flags, appended verbatim to whichever backend is
# launched. Leave blank for CPU-only or a build that auto-selects its
# device.
# CUDA example (usually no flag needed, GPU_LAYERS alone is enough):
#   EXTRA_ARGS=
# Vulkan example (some builds need an explicit device index — check with
# `llama-server.exe --list-devices` or `llama.exe serve --help` first):
#   EXTRA_ARGS=-dev Vulkan1
EXTRA_ARGS=

# --- Agent API (read by agent/config.py and Start-Agent.bat) ----------
AGENT_PORT=8787
# Model name string sent to the /v1/chat/completions API. Must match
# what your chosen backend reports for the model you loaded via
# MODEL_PATH.
LLM_MODEL_NAME=local-model
# Tool-calling protocol: "native" (OpenAI-style tool_calls; needs a
# model/template that supports it) or "fallback" (single JSON action per
# turn — more reliable on small/quantized models that don't do native
# tool calling well).
TOOL_MODE=native
# Agent loop budgets.
MAX_AGENT_TURNS=12
COMMAND_TIMEOUT_SECONDS=90

# --- Tuning notes -------------------------------------------------------
# GPU_LAYERS: 0 = CPU-only. Otherwise raise by 2 at a time and watch your
#   GPU's memory usage (e.g. `nvidia-smi -l 1` on NVIDIA) while a request
#   runs; back off by at least 2 on an out-of-memory error. Leave some
#   headroom below your card's total VRAM.
# CONTEXT_SIZE: bigger uses more RAM/VRAM and slows first-token latency.
#   Set to what your tasks actually need.
# CPU_THREADS: benchmark a few values on your own machine; no universal
#   best — depends on core count and background load.